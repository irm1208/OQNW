modules = ["nodejs-20", "web", "bash", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["bash", "-c", "PORT=8080 NODE_ENV=production node artifacts/api-server/dist/index.mjs & PORT=5000 BASE_PATH=/ pnpm --filter @workspace/omniqure run serve"]
build = ["bash", "-c", "pnpm install && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/omniqure run build && pnpm --filter @workspace/admin-panel run build"]

[[deployment.responseHeaders]]
path = "/*"
name = "X-Content-Type-Options"
value = "nosniff"

[[deployment.responseHeaders]]
path = "/*"
name = "X-Frame-Options"
value = "SAMEORIGIN"

[[deployment.responseHeaders]]
path = "/*"
name = "Referrer-Policy"
value = "strict-origin-when-cross-origin"

[[deployment.responseHeaders]]
path = "/*"
name = "Permissions-Policy"
value = "camera=(), microphone=(), geolocation=()"

[[deployment.responseHeaders]]
path = "/*"
name = "Strict-Transport-Security"
value = "max-age=31536000; includeSubDomains"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[[deployment.rewrites]]
from = "/sign-up"
to = "/sign-up/index.html"

[[deployment.rewrites]]
from = "/refer-a-friend"
to = "/refer-a-friend/index.html"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Storefront"

[[workflows.workflow]]
name = "Storefront"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ API_PORT=8080 pnpm --filter @workspace/omniqure run dev"
waitForPort = 5000

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3002
externalPort = 4200

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8083
externalPort = 3001

[[ports]]
localPort = 25553
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
LOG_LEVEL = "info"
SITE_URL = "https://omniqure.com"
EMAIL_FROM = "OmniQure <noreply@omniqure.com>"
PORT = "5000"
API_PORT = "8080"
BASE_PATH = "/"
NODE_ENV = "development"
